# -------------------------------------------------------
# Copy this file to .env and fill in the required values.
# .env is git-ignored. Never commit real secrets.
# -------------------------------------------------------

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev, no Docker):
DATABASE_URL=sqlite:///./disaster_coordinator.db

# PostgreSQL (Docker / production) — used automatically by docker-compose.yml:
# DATABASE_URL=postgresql+psycopg2://dc_user:changeme@localhost:5432/disaster_coordinator

# PostgreSQL password used by docker-compose.yml
POSTGRES_PASSWORD=changeme_in_production

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT — REQUIRED ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── Encryption key for PII at rest ───────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── LLM — Local tier (LM Studio or any OpenAI-compatible endpoint) ────────────
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=smollm3-3b

# ── LLM — Strong tier (OpenRouter / OpenAI) ──────────────────────────────────
# Leave blank to use local tier only.
STRONG_MODEL_BASE_URL=https://openrouter.ai/api/v1
STRONG_MODEL_API_KEY=
STRONG_MODEL_NAME=inclusionai/ling-3.1-flash

# ── CORS — comma-separated allowed origins for the frontend ──────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Constraints ───────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
SOLVER_TIMEOUT_SECONDS=5
MAX_EVALUATION_RETRIES=2
